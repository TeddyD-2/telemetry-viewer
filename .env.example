# The one password everybody on the team types to get in.
SITE_PASSWORD=change-me

# Signs the session cookie. Any long random string; changing it signs everyone out.
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=

# Uploader dropdown. Comma-separated; free text is still allowed.
TEAM_MEMBERS=

# Set for you by `vercel install neon` and `vercel env pull`:
#   DATABASE_URL=postgres://...
#   BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
